# Absolute base URL of the live site, used for links embedded in outbound emails
# (e.g. the KServe Lead Lost Alert "Download Excel Report" button). Required on
# any deployment that isn't `next dev` — without it, email-trigger sends that need
# an absolute URL fail loudly instead of guessing the wrong domain.
NEXT_PUBLIC_APP_URL=https://your-live-domain.example.com

# Existing CRM authentication/database settings remain required.
# Order-form values are server-only; never prefix either value with NEXT_PUBLIC_.
ORDER_FORM_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
ORDER_FORM_APPS_SCRIPT_SECRET=replace-with-at-least-32-random-characters

# Optional central audit forwarding already supported by the CRM.
CRM_SECURITY_AUDIT_WEBHOOK_URL=
CRM_SECURITY_AUDIT_WEBHOOK_TOKEN=
